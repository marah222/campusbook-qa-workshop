{
  "name": "campusbook-qa-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CampusBook: intentionally imperfect university QA workshop application",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node server/server.mjs",
    "dev": "npm run build && npm run start",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:unit": "vitest run tests/unit",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:all": "npm run test:unit && npm run test:api && npm run test:ui",
    "classroom:preflight": "node scripts/classroom-preflight.mjs",
    "classroom:reset": "node scripts/reset-scope.mjs",
    "classroom:starters": "node scripts/check-starter-layout.mjs",
    "classroom:verify": "node scripts/verify-workshop.mjs",
    "classroom:playwright-list": "node scripts/verify-playwright-list.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "5.0.1"
  }
}
